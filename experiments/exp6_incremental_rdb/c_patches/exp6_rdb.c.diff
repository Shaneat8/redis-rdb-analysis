+/* === EXP6 INCREMENTAL RDB ===
+ * Walks only db->dirty_keys + emits tombstones for db->deleted_keys.
+ * The output file's first opcode is RDB_OPCODE_INCR_HEADER followed by
+ * a 40-byte base UUID. After a successful save, both sets are cleared. */
+int rdbSaveIncremental(char *filename, char *base_uuid) {
+    char tmpfile[256];
+    char magic[10];
+    FILE *fp;
+    rio rdb;
+    int err = 0;
+    int j;
+    long long total_keys = 0, total_dels = 0;
+
+    snprintf(tmpfile,256,"temp-incr-%d.rdb", (int)getpid());
+    fp = fopen(tmpfile,"w");
+    if (!fp) {
+        serverLog(LL_WARNING, "EXP6 incr save: cannot open %s: %s",
+                  tmpfile, strerror(errno));
+        return C_ERR;
+    }
+    rioInitWithFile(&rdb, fp);
+    if (server.rdb_checksum) rdb.update_cksum = rioGenericUpdateChecksum;
+
+    snprintf(magic, sizeof(magic), "REDIS%04d", RDB_VERSION);
+    if (rdbWriteRaw(&rdb, magic, 9) == -1) goto werr;
+
+    /* Incremental header: opcode + 40-byte base UUID */
+    if (rdbSaveType(&rdb, RDB_OPCODE_INCR_HEADER) == -1) goto werr;
+    char uuid_buf[40];
+    memset(uuid_buf, 0, 40);
+    if (base_uuid) strncpy(uuid_buf, base_uuid, 40);
+    if (rdbWriteRaw(&rdb, uuid_buf, 40) == -1) goto werr;
+
+    for (j = 0; j < server.dbnum; j++) {
+        redisDb *db = server.db + j;
+        if (!db->dirty_keys) continue;
+        if (dictSize(db->dirty_keys) == 0 && dictSize(db->deleted_keys) == 0)
+            continue;
+
+        if (rdbSaveType(&rdb, RDB_OPCODE_SELECTDB) == -1) goto werr;
+        if (rdbSaveLen(&rdb, j) == -1) goto werr;
+
+        /* Walk dirty_keys, resolve live values from db->dict */
+        dictIterator *di = dictGetSafeIterator(db->dirty_keys);
+        dictEntry *de;
+        while ((de = dictNext(di)) != NULL) {
+            sds keystr = dictGetKey(de);
+            dictEntry *live = dictFind(db->dict, keystr);
+            if (!live) continue;  /* deleted, handled below */
+            robj key, *o = dictGetVal(live);
+            initStaticStringObject(key, keystr);
+            long long expire = getExpire(db, &key);
+            if (rdbSaveKeyValuePair(&rdb, &key, o, expire) == -1) {
+                dictReleaseIterator(di);
+                goto werr;
+            }
+            total_keys++;
+        }
+        dictReleaseIterator(di);
+
+        /* Walk deleted_keys, emit tombstones */
+        di = dictGetSafeIterator(db->deleted_keys);
+        while ((de = dictNext(di)) != NULL) {
+            sds keystr = dictGetKey(de);
+            if (rdbSaveType(&rdb, RDB_OPCODE_INCR_DELETE) == -1) {
+                dictReleaseIterator(di);
+                goto werr;
+            }
+            if (rdbSaveRawString(&rdb,(unsigned char*)keystr,sdslen(keystr)) == -1) {
+                dictReleaseIterator(di);
+                goto werr;
+            }
+            total_dels++;
+        }
+        dictReleaseIterator(di);
+    }
+
+    if (rdbSaveType(&rdb, RDB_OPCODE_EOF) == -1) goto werr;
+    uint64_t cksum = rdb.cksum;
+    memrev64ifbe(&cksum);
+    if (rioWrite(&rdb, &cksum, 8) == 0) goto werr;
+
+    if (fflush(fp) == EOF) goto werr;
+    if (fsync(fileno(fp)) == -1) goto werr;
+    if (fclose(fp) == EOF) { fp = NULL; goto werr; }
+    fp = NULL;
+
+    if (rename(tmpfile, filename) == -1) {
+        serverLog(LL_WARNING, "EXP6 incr save: rename failed: %s", strerror(errno));
+        unlink(tmpfile);
+        return C_ERR;
+    }
+
+    /* Success — clear dirty/deleted sets */
+    for (j = 0; j < server.dbnum; j++) {
+        redisDb *db = server.db + j;
+        if (db->dirty_keys)  { dictEmpty(db->dirty_keys, NULL); }
+        if (db->deleted_keys){ dictEmpty(db->deleted_keys, NULL); }
+    }
+    serverLog(LL_NOTICE,"EXP6 incremental RDB saved: %lld keys, %lld tombstones -> %s",
+              total_keys, total_dels, filename);
+    return C_OK;
+
+werr:
+    err = errno;
+    serverLog(LL_WARNING,"EXP6 incr save error: %s", strerror(err));
+    if (fp) fclose(fp);
+    unlink(tmpfile);
+    return C_ERR;
+}
