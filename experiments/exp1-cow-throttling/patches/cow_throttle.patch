+    createSizeTConfig("bgsave-cow-throttle-bytes",    NULL, MODIFIABLE_CONFIG, 0, SIZE_MAX, server.bgsave_cow_throttle_bytes,    0,   MEMORY_CONFIG,  NULL, NULL),
+    createIntConfig  ("bgsave-cow-throttle-delay-us", NULL, MODIFIABLE_CONFIG, 0, 1000000, server.bgsave_cow_throttle_delay_us, 200, INTEGER_CONFIG, NULL, NULL),
+
     /* ... rest of table ... */
     {NULL}
 };
